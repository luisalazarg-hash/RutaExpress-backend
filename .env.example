# Copia a .env y reemplaza los valores de Azure por los de tu tenant y registro de aplicaciones.
AZURE_ISSUER_URI=https://login.microsoftonline.com/TENANT_ID/v2.0
AUTH_AZURE_TENANT_ID=TENANT_ID
AUTH_AZURE_API_CLIENT_ID=API_CLIENT_ID
VITE_AZURE_CLIENT_ID=FRONTEND_CLIENT_ID
VITE_AZURE_TENANT_ID=TENANT_ID
VITE_AZURE_API_SCOPE=api://API_CLIENT_ID/.default

# Solo para desarrollo local con el PostgreSQL del Compose.
POSTGRES_USER=rutaexpress
POSTGRES_PASSWORD=rutaexpress_local
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173
